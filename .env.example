# Copiez ce fichier en ".env.local" en local, et renseignez les mêmes
# variables dans les paramètres du projet sur Vercel (Settings → Environment
# Variables) avant de déployer.

# Clé API Resend (https://resend.com) — gratuite jusqu'à 100 e-mails/jour.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse d'expédition. Pour démarrer sans configurer de domaine, utilisez
# "onboarding@resend.dev" (fourni par Resend pour les tests). Pour la
# production, vérifiez votre propre domaine dans Resend puis utilisez
# une adresse de ce domaine (ex. "reservation@black-excellence.ch").
RESERVATION_EMAIL_FROM=onboarding@resend.dev

# Adresse e-mail du chauffeur qui doit recevoir les demandes.
RESERVATION_EMAIL_TO=chauffeur@example.com
